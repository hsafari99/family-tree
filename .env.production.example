# Copy to .env.production on the server. Never commit the real file.
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# Postgres runs in the same compose project; use a long random password.
# The CHANGE_ME placeholder is rejected at startup by design, so it can't ship by accident.
DATABASE_URL=postgres://family:CHANGE_ME@postgres:5432/family
WEB_ORIGIN=https://family.cortextechservices.com
AUTH_BASE_URL=https://api.family.cortextechservices.com
# Trusted proxy hops in front of the API. Raise it only if another proxy (e.g. a CDN) is added.
# Caddy is the single trusted hop.
TRUST_PROXY=1
# 32+ random characters: `openssl rand -base64 48`
SESSION_SECRET=
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=family-photos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_CREATE_BUCKET=false

# Web app (not read by the API): set as a Cloudflare Pages *build* variable, not here.
# VITE_API_BASE_URL=https://api.family.cortextechservices.com

# How many non-deleted trees one user may own.
MAX_TREES_PER_USER=3
